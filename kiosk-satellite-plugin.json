{
  "schemaVersion": 1,
  "id": "ks-navbar",
  "name": "Navigation bar",
  "version": "0.20.2",
  "apiVersion": 1,
  "minAppVersion": "2026.10.42",
  "minAndroidSdk": 26,
  "entryClass": "com.shymoose.ksnavbar.NavbarPlugin",
  "description": "A navigation bar for your dashboards that highlights the page you're on.",
  "author": "dimatx",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "capabilities": [
    "overlay",
    "host.read",
    "host.control"
  ],
  "settings": [
    {
      "key": "position",
      "type": "select",
      "title": "Position",
      "default": "Bottom",
      "group": "Appearance",
      "description": "The edge of the screen the bar sits on.",
      "options": [
        "Bottom",
        "Top",
        "Left",
        "Right"
      ]
    },
    {
      "key": "labels",
      "type": "select",
      "title": "Labels",
      "default": "Always",
      "group": "Appearance",
      "description": "When item names show under their icons.",
      "options": [
        "Always",
        "Active only",
        "Never"
      ]
    },
    {
      "key": "scale",
      "type": "select",
      "title": "Size",
      "default": "100%",
      "group": "Appearance",
      "description": "The size of the bar and its menus.",
      "options": [
        "80%",
        "90%",
        "100%",
        "110%",
        "120%",
        "140%"
      ]
    },
    {
      "key": "opacity",
      "type": "number",
      "title": "Opacity",
      "default": 100,
      "group": "Appearance",
      "description": "How much of the dashboard shows through.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "key": "items",
      "type": "list",
      "title": "Items",
      "default": [
        {
          "label": "Home",
          "opens": "Page",
          "page": "lovelace/0",
          "icon": "mdi:home-outline",
          "iconSelected": "mdi:home"
        }
      ],
      "group": "Items",
      "addTitle": "Add item",
      "maxItems": 16,
      "row": {
        "title": "label",
        "subtitle": [
          "page",
          "action",
          "url",
          "anyAction"
        ],
        "icon": "icon"
      },
      "fields": [
        {
          "key": "label",
          "type": "string",
          "title": "Label",
          "required": true
        },
        {
          "key": "opens",
          "type": "select",
          "title": "Opens",
          "options": [
            "Page",
            "Built-in page",
            "Camera view",
            "Calendar",
            "Menu",
            "Kiosk action",
            "App",
            "Any action",
            "Web address"
          ]
        },
        {
          "key": "page",
          "type": "dashboard",
          "title": "Page",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Page"
          }
        },
        {
          "key": "panel",
          "type": "select",
          "title": "Built-in page",
          "options": [
            "Energy",
            "Map",
            "Logbook",
            "History",
            "To-do",
            "Media",
            "Other"
          ],
          "description": "A page Home Assistant provides itself. Other opens a path you type.",
          "visibleWhen": {
            "key": "opens",
            "equals": "Built-in page"
          }
        },
        {
          "key": "panelPath",
          "type": "string",
          "title": "Path",
          "description": "The path after your Home Assistant address, such as profile.",
          "required": true,
          "visibleWhen": {
            "key": "panel",
            "equals": "Other"
          }
        },
        {
          "key": "camera",
          "type": "cameraView",
          "title": "Camera view",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Camera view"
          }
        },
        {
          "key": "calendarView",
          "type": "select",
          "title": "Calendar view",
          "options": [
            "Default",
            "Day",
            "Week",
            "Month",
            "Schedule"
          ],
          "description": "Default opens the view picked under Settings > Calendar. Needs Kiosk Satellite 2026.10.33 or newer.",
          "visibleWhen": {
            "key": "opens",
            "equals": "Calendar"
          }
        },
        {
          "key": "action",
          "type": "select",
          "title": "Action",
          "options": [
            "Music",
            "Now playing",
            "Screensaver",
            "App launcher",
            "Reload",
            "Start page"
          ],
          "visibleWhen": {
            "key": "opens",
            "equals": "Kiosk action"
          }
        },
        {
          "key": "app",
          "type": "string",
          "title": "App",
          "choices": "plugin",
          "required": true,
          "description": "An app from Settings > App Launcher > Apps. Refresh lists them.",
          "emptyText": "Add apps under Settings > App Launcher > Apps, then Refresh.",
          "visibleWhen": {
            "key": "opens",
            "equals": "App"
          }
        },
        {
          "key": "anyAction",
          "type": "action",
          "title": "Action",
          "required": true,
          "description": "What a tap runs, such as a script or another plugin's action.",
          "visibleWhen": {
            "key": "opens",
            "equals": "Any action"
          }
        },
        {
          "key": "url",
          "type": "string",
          "title": "Web address",
          "description": "An address starting with https://.",
          "required": true,
          "visibleWhen": {
            "key": "opens",
            "equals": "Web address"
          }
        },
        {
          "key": "entries",
          "type": "list",
          "title": "Menu entries",
          "description": "Menus with more than 6 entries show as a grid.",
          "addTitle": "Add entry",
          "minItems": 1,
          "maxItems": 16,
          "visibleWhen": {
            "key": "opens",
            "equals": "Menu"
          },
          "row": {
            "title": "label",
            "subtitle": [
              "page",
              "action",
              "url",
              "anyAction"
            ],
            "icon": "icon"
          },
          "fields": [
            {
              "key": "label",
              "type": "string",
              "title": "Label",
              "required": true
            },
            {
              "key": "opens",
              "type": "select",
              "title": "Opens",
              "options": [
                "Page",
                "Built-in page",
                "Camera view",
                "Calendar",
                "Kiosk action",
                "App",
                "Any action",
                "Web address"
              ]
            },
            {
              "key": "page",
              "type": "dashboard",
              "title": "Page",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Page"
              }
            },
            {
              "key": "panel",
              "type": "select",
              "title": "Built-in page",
              "options": [
                "Energy",
                "Map",
                "Logbook",
                "History",
                "To-do",
                "Media",
                "Other"
              ],
              "description": "A page Home Assistant provides itself. Other opens a path you type.",
              "visibleWhen": {
                "key": "opens",
                "equals": "Built-in page"
              }
            },
            {
              "key": "panelPath",
              "type": "string",
              "title": "Path",
              "description": "The path after your Home Assistant address, such as profile.",
              "required": true,
              "visibleWhen": {
                "key": "panel",
                "equals": "Other"
              }
            },
            {
              "key": "camera",
              "type": "cameraView",
              "title": "Camera view",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Camera view"
              }
            },
            {
              "key": "calendarView",
              "type": "select",
              "title": "Calendar view",
              "options": [
                "Default",
                "Day",
                "Week",
                "Month",
                "Schedule"
              ],
              "description": "Default opens the view picked under Settings > Calendar. Needs Kiosk Satellite 2026.10.33 or newer.",
              "visibleWhen": {
                "key": "opens",
                "equals": "Calendar"
              }
            },
            {
              "key": "action",
              "type": "select",
              "title": "Action",
              "options": [
                "Music",
                "Now playing",
                "Screensaver",
                "App launcher",
                "Reload",
                "Start page"
              ],
              "visibleWhen": {
                "key": "opens",
                "equals": "Kiosk action"
              }
            },
            {
              "key": "app",
              "type": "string",
              "title": "App",
              "choices": "plugin",
              "required": true,
              "description": "An app from Settings > App Launcher > Apps. Refresh lists them.",
              "emptyText": "Add apps under Settings > App Launcher > Apps, then Refresh.",
              "visibleWhen": {
                "key": "opens",
                "equals": "App"
              }
            },
            {
              "key": "anyAction",
              "type": "action",
              "title": "Action",
              "required": true,
              "description": "What a tap runs, such as a script or another plugin's action.",
              "visibleWhen": {
                "key": "opens",
                "equals": "Any action"
              }
            },
            {
              "key": "url",
              "type": "string",
              "title": "Web address",
              "description": "An address starting with https://.",
              "required": true,
              "visibleWhen": {
                "key": "opens",
                "equals": "Web address"
              }
            },
            {
              "key": "icon",
              "type": "icon",
              "title": "Icon",
              "description": "Leave empty to have one picked from the label."
            }
          ]
        },
        {
          "key": "tapPage",
          "type": "dashboard",
          "title": "Tap opens",
          "description": "Optional. A tap opens this page and a long press opens the menu.",
          "visibleWhen": {
            "key": "opens",
            "equals": "Menu"
          }
        },
        {
          "key": "icon",
          "type": "icon",
          "title": "Icon",
          "description": "Leave empty to have one picked from the label."
        },
        {
          "key": "iconSelected",
          "type": "icon",
          "title": "Selected icon",
          "description": "The icon while this item's page is open. Uses Icon when empty."
        }
      ]
    },
    {
      "key": "collapse",
      "type": "select",
      "title": "Swipe to hide",
      "default": "Start visible",
      "group": "Behavior",
      "description": "Swipe the bar toward its edge to hide it behind a small tab.",
      "options": [
        "Start visible",
        "Start hidden",
        "Off"
      ]
    },
    {
      "key": "autoCollapse",
      "type": "number",
      "title": "Hide after",
      "default": 0,
      "group": "Behavior",
      "description": "How long the bar stays visible without a tap. 0 keeps it visible.",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "s",
      "visibleWhen": {
        "key": "collapse",
        "notEquals": "Off"
      }
    },
    {
      "key": "makeRoom",
      "type": "boolean",
      "title": "Keep the dashboard clear",
      "default": true,
      "group": "Behavior",
      "description": "End the dashboard above the bar instead of under it."
    },
    {
      "key": "overCameras",
      "type": "boolean",
      "title": "Show over camera views",
      "default": true,
      "group": "Behavior",
      "description": "Keep the bar on screen while a camera view is open, with a button to close it."
    },
    {
      "key": "hideOn",
      "type": "list",
      "title": "Pages",
      "default": [],
      "group": "Hide the bar on",
      "description": "The bar stays hidden on these pages.",
      "addTitle": "Add page",
      "maxItems": 32,
      "row": {
        "title": "page"
      },
      "fields": [
        {
          "key": "page",
          "type": "dashboard",
          "title": "Page",
          "required": true
        }
      ]
    }
  ],
  "commands": [
    {
      "id": "show",
      "title": "Show navigation bar"
    },
    {
      "id": "hide",
      "title": "Hide navigation bar"
    },
    {
      "id": "toggle",
      "title": "Toggle navigation bar"
    }
  ],
  "groups": [
    {
      "title": "Appearance"
    },
    {
      "title": "Items"
    },
    {
      "title": "Behavior"
    },
    {
      "title": "Hide the bar on"
    }
  ]
}
